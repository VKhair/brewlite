# Local development placeholders only. Never commit real credentials.

# Database
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=change_me
POSTGRES_DB=brewlite
DATABASE_URL=postgresql://brewlite:change_me@localhost:5432/brewlite

# API
PORT=3001
JWT_SECRET=replace_with_a_long_random_secret_32_bytes_minimum
JWT_EXPIRES_IN=1d

# VNPay Sandbox (backend only; do not expose secrets to the Web bundle)
VNPAY_TMN_CODE=replace_with_sandbox_merchant_code
VNPAY_HASH_SECRET=replace_with_sandbox_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Replace callback paths with the routes implemented by the API/Web application.
VNPAY_RETURN_URL=http://localhost:3000/replace-with-web-return-route
VNPAY_IPN_URL=http://localhost:3001/replace-with-api-ipn-route

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
