# Local development only. Keep real credentials out of Git.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=brewlite_local_only
POSTGRES_DB=brewlite
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:brewlite_local_only@localhost:5433/brewlite

# Inside Docker Compose, DATABASE_URL is constructed with the postgres service host.

# Local host ports are separated from the older BrewLite instance, if it is running.
API_PORT=3003
WEB_PORT=3002
API_INTERNAL_URL=http://localhost:3003

# Use a random secret for any non-demo environment.
JWT_SECRET=brewlite-local-only-jwt-secret-change-before-deploy
JWT_EXPIRES_IN=1d

# Mock is the default; set PAYMENT_MODE=vnpay and provide Sandbox credentials to use redirect checkout.
PAYMENT_MODE=mock
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3003/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:3003/payments/vnpay/ipn
VNPAY_FRONTEND_URL=http://localhost:3002
