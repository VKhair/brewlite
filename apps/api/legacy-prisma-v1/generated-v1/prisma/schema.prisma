// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  EWALLET
  CARD
  VNPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  fullName      String   @map("full_name")
  phone         String?
  passwordHash  String   @map("password_hash")
  role          UserRole @default(CUSTOMER)
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orders              Order[]
  payments            Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  statusHistories     OrderStatusHistory[]

  @@map("users")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String   @default("")
  basePrice   Int      @map("base_price")
  imageUrl    String   @map("image_url")
  category    String
  stock       Int      @default(100)
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sizes      ProductSize[]
  toppings   ProductTopping[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductSize {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  name       String // S, M, L
  priceDelta Int     @default(0) @map("price_delta")
  isDefault  Boolean @default(false) @map("is_default")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@map("product_sizes")
}

model Topping {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  price       Int
  isAvailable Boolean @default(true) @map("is_available")

  products ProductTopping[]

  @@map("toppings")
}

model ProductTopping {
  productId String @map("product_id") @db.Uuid
  toppingId String @map("topping_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  topping Topping @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  @@id([productId, toppingId])
  @@map("product_toppings")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  orderCode         String      @unique @map("order_code")
  userId            String      @map("user_id") @db.Uuid
  status            OrderStatus @default(PENDING)
  subtotalAmount    Int         @default(0) @map("subtotal_amount")
  promotionDiscount Int         @default(0) @map("promotion_discount")
  loyaltyDiscount   Int         @default(0) @map("loyalty_discount")
  totalAmount       Int         @map("total_amount")
  itemsSnapshot     Json?       @map("items_snapshot")
  promotionId       String?     @map("promotion_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id])
  promotion           Promotion?           @relation(fields: [promotionId], references: [id])
  items               OrderItem[]
  payments            Payment[]
  statusHistories     OrderStatusHistory[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  productName  String   @map("product_name")
  size         String   @default("M")
  toppingNames String[] @default([]) @map("topping_names")
  note         String   @default("")
  quantity     Int      @default(1)
  unitPrice    Int      @map("unit_price")
  subtotal     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorId    String       @map("actor_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id])

  @@map("order_status_history")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  orderId              String        @map("order_id") @db.Uuid
  idempotencyKey       String        @map("idempotency_key") @db.Uuid
  paymentMethod        PaymentMethod @map("payment_method")
  amount               Int
  status               PaymentStatus @default(PENDING)
  gatewayTransactionId String?       @map("gateway_transaction_id")
  failureReason        String?       @map("failure_reason")
  responsePayload      Json?         @map("response_payload")
  createdAt            DateTime      @default(now()) @map("created_at")
  paidAt               DateTime?     @map("paid_at")

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@map("payments")
}

model Promotion {
  id             String        @id @default(uuid()) @db.Uuid
  code           String        @unique
  type           PromotionType @default(PERCENTAGE)
  discountValue  Int           @map("discount_value")
  minOrderAmount Int           @default(0) @map("min_order_amount")
  startAt        DateTime      @default(now()) @map("start_at")
  endAt          DateTime      @map("end_at")
  usageLimit     Int           @default(100) @map("usage_limit")
  usedCount      Int           @default(0) @map("used_count")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")

  orders Order[]

  @@map("promotions")
}

model LoyaltyTransaction {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  orderId     String?                @map("order_id") @db.Uuid
  points      Int
  type        LoyaltyTransactionType
  description String                 @default("")
  createdAt   DateTime               @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@map("loyalty_transactions")
}
