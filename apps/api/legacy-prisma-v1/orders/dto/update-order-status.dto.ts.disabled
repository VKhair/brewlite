import { IsEnum } from 'class-validator';
import { OrderStatus } from '@prisma/client';

export class UpdateOrderStatusDto {
  @IsEnum(OrderStatus, {
    message: 'Trạng thái không hợp lệ. Phải là một trong: PENDING, PAID, PREPARING, READY, COMPLETED, PAYMENT_FAILED, CANCELLED',
  })
  status!: OrderStatus;
}
