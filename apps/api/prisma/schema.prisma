generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @db.Uuid
  email         String   @unique
  fullName      String   @map("full_name")
  phone         String?
  passwordHash  String   @map("password_hash")
  role          String   @default("CUSTOMER")
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  orders        Order[]
  payments      Payment[]
  history       OrderStatusHistory[]
  loyaltyTransactions LoyaltyTransaction[]

  @@map("users")
}

model Product {
  id          String        @id @db.Uuid
  name        String
  description String        @default("")
  basePrice   Int           @map("base_price")
  imageUrl    String        @map("image_url")
  category    String
  isAvailable Boolean       @default(true) @map("is_available")
  stock       Int           @default(100)
  sizes       ProductSize[]
  toppings    ProductTopping[]
  recipes     ProductRecipe[]

  @@map("products")
}

model ProductSize {
  id         String  @id @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  name       String
  priceDelta Int     @default(0) @map("price_delta")
  isDefault  Boolean @default(false) @map("is_default")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@map("product_sizes")
}

model Topping {
  id          String           @id @db.Uuid
  name        String
  price       Int
  isAvailable Boolean          @default(true) @map("is_available")
  products    ProductTopping[]
  recipes     ToppingRecipe[]

  @@map("toppings")
}

model ProductTopping {
  productId String  @map("product_id") @db.Uuid
  toppingId String  @map("topping_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  topping   Topping @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  @@id([productId, toppingId])
  @@map("product_toppings")
}

model Order {
  id              String               @id @db.Uuid
  orderCode       String               @unique @map("order_code")
  userId          String               @map("user_id") @db.Uuid
  status          String               @default("PENDING")
  subtotalAmount  Int                  @default(0) @map("subtotal_amount")
  discountAmount  Int                  @default(0) @map("discount_amount")
  pointsUsed      Int                  @default(0) @map("points_used")
  pointsDiscount  Int                  @default(0) @map("points_discount")
  pointsEarned    Int                  @default(0) @map("points_earned")
  couponCode      String?              @map("coupon_code")
  totalAmount     Int                  @map("total_amount")
  items           Json
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  user            User                 @relation(fields: [userId], references: [id])
  payments        Payment[]
  history         OrderStatusHistory[]
  inventoryMovements InventoryMovement[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("orders")
}

model OrderStatusHistory {
  id        String   @id @db.Uuid
  sequence  BigInt   @unique @default(autoincrement())
  orderId   String   @map("order_id") @db.Uuid
  fromStatus String? @map("from_status")
  toStatus  String   @map("to_status")
  actorId   String   @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order     Order    @relation(fields: [orderId], references: [id])
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id             String   @id @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.Uuid
  paymentMethod  String   @map("payment_method")
  mockOutcome    String?  @map("mock_outcome")
  amount         Int
  status         String
  response       Json
  providerTxnRef String?  @unique @map("provider_txn_ref")
  paymentUrl     String?  @map("payment_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([orderId])
  @@map("payments")
}

model Coupon {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique
  discountPercent Int?     @map("discount_percent")
  discountAmount  Int?     @map("discount_amount")
  minOrderAmount  Int      @default(0) @map("min_order_amount")
  maxDiscount     Int?     @map("max_discount")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("coupons")
}

model LoyaltyTransaction {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orderId   String?  @map("order_id") @db.Uuid
  points    Int
  type      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
  @@unique([orderId, type])
  @@map("loyalty_transactions")
}

model Ingredient {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  unit      String
  onHand    Decimal  @default(0) @map("on_hand") @db.Decimal(14, 3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  recipes   ProductRecipe[]
  toppings  ToppingRecipe[]
  movements InventoryMovement[]

  @@map("ingredients")
}

model ProductRecipe {
  id           Int        @id @default(autoincrement())
  productId    String     @map("product_id") @db.Uuid
  ingredientId Int        @map("ingredient_id")
  size         String
  quantity     Decimal    @db.Decimal(12, 3)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, size, ingredientId])
  @@index([ingredientId])
  @@map("product_recipes")
}

model ToppingRecipe {
  id           Int        @id @default(autoincrement())
  toppingId    String     @map("topping_id") @db.Uuid
  ingredientId Int        @map("ingredient_id")
  quantity     Decimal    @db.Decimal(12, 3)
  topping      Topping    @relation(fields: [toppingId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([toppingId, ingredientId])
  @@index([ingredientId])
  @@map("topping_recipes")
}

model InventoryMovement {
  id           Int        @id @default(autoincrement())
  ingredientId Int        @map("ingredient_id")
  type         String
  quantity     Decimal    @db.Decimal(14, 3)
  reason       String
  orderId      String?    @map("order_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  order        Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, ingredientId, type])
  @@index([ingredientId, createdAt])
  @@map("inventory_movements")
}
