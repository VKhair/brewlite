@startuml
title BrewLite — Hoạt động đặt và thanh toán
skinparam shadowing false

|Web|
start
:Duyệt thực đơn, chọn món và chỉnh giỏ;
if (Có phiên?) then (có)
else (chưa)
  :Đăng nhập hoặc đăng ký;
  :Quay lại checkout;
endif
:Gửi POST /orders với các dòng hàng;

|API và PostgreSQL|
:Tính lại giá, kiểm tra lựa chọn và tồn;
if (Tạo đơn được?) then (có)
  :Ghi PENDING, snapshot, giữ tồn và lịch sử;
else (lỗi)
  :Rollback và trả lỗi;
  |Web|
  :Hiện lỗi và giữ giỏ;
  stop
endif

|Web|
:Gửi POST /payments với khóa UUID v4;

|API và PostgreSQL|
if (Chế độ VNPay?) then (VNPay)
  :Tạo Payment PENDING và URL có chữ ký;
  |VNPay Sandbox|
  :Nhận trình duyệt vào trang thanh toán;
  note right
    Return và IPN đến độc lập.
    Trang kết quả có thể mở khi đơn vẫn PENDING.
  end note
  fork
    :Đưa trình duyệt đến Return URL;
    |API và PostgreSQL|
    :Xác minh Return và điều hướng về web;
  fork again
    |VNPay Sandbox|
    :Gửi IPN đến API;
    |API và PostgreSQL|
    :Kiểm tra IPN để chốt kết quả được hỗ trợ;
  end merge
else (mock)
  :Mô phỏng thanh toán ví hoặc thẻ;
endif

|API và PostgreSQL|
if (Đã có kết quả chốt?) then (có)
  if (Thành công?) then (có)
    :Ghi SUCCESS, PAID và cộng điểm;
    |Web|
    :Hiển thị kết quả và xóa giỏ;
  else (lỗi)
    |API và PostgreSQL|
    :Ghi FAILED, PAYMENT_FAILED và hoàn tồn;
    |Web|
    :Giữ giỏ và cho phép thử lại;
  endif
else (chờ IPN)
  |Web|
  :Trang kết quả hỏi lại khi còn PENDING;
endif
stop
@enduml
