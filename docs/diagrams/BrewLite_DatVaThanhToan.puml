@startuml
left to right direction
skinparam shadowing false
skinparam actorStyle stickman
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam defaultFontName Arial

actor "Khách đã đăng nhập\n(Member Customer)" as Member
rectangle "HỆ THỐNG BREWLITE - ĐẶT & THANH TOÁN" {
  usecase "UC-06\nXem & quản lý giỏ hàng" as UC06
  usecase "UC-11\nTạo đơn hàng (Checkout)" as UC11
  usecase "UC-12\nKiểm tra dữ liệu & tồn kho" as UC12
  usecase "UC-13\nThanh toán qua VNPay Sandbox" as UC13
  usecase "UC-14\nXử lý giao dịch thanh toán\n(Idempotency-Key)" as UC14
  usecase "UC-15\nÁp dụng mã khuyến mãi" as UC15
  usecase "UC-16\nTích lũy & Sử dụng điểm thưởng" as UC16
  usecase "UC-17\nThanh toán thất bại & bảo toàn giỏ" as UC17
  usecase "UC-18\nXem xác nhận đơn hàng (PAID)" as UC18
  usecase "UC-21\nXem lịch sử đơn hàng cá nhân" as UC21

  UC11 ..> UC12 : <<include>>
  UC11 ..> UC13 : <<include>>
  UC13 ..> UC14 : <<include>>
  UC18 .> UC13 : <<extend>>\n[khi thanh toán được xác minh thành công]
  UC15 ..> UC11 : <<extend>>\n(khi áp voucher)
  UC16 ..> UC13 : <<extend>>\n(khi dùng điểm)
  UC17 ..> UC13 : <<extend>>\n(khi thanh toán lỗi)
}
actor "VNPay Sandbox\n(External Payment System)" as Gateway
note right of UC11
  Precondition: Member đã có JWT hợp lệ.
  Nếu chưa đăng nhập, hoàn tất UC-09 rồi tiếp tục checkout.
end note
Member -- UC06
Member -- UC11
Member -- UC13
Member -- UC15
Member -- UC16
Member -- UC17
Member -- UC18
Member -- UC21
UC13 -- Gateway
@enduml
