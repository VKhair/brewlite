@startuml
title BrewLite — Mô hình dữ liệu Prisma
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty methods

package "Danh mục" {
  class Product {
    id: UUID
    basePrice: Int
    isAvailable: Boolean
    stock: Int
  }
  class ProductSize {
    id: UUID
    name: String
    priceDelta: Int
    isDefault: Boolean
  }
  class Topping {
    id: UUID
    name: String
    price: Int
    isAvailable: Boolean
  }
  class ProductTopping {
    productId: UUID
    toppingId: UUID
  }
}

package "Đơn, thanh toán và tài khoản" {
  class User {
    id: UUID
    email: String
    passwordHash: String
    role: String
    loyaltyPoints: Int
  }
  class Order {
    id: UUID
    orderCode: String
    status: String
    subtotalAmount: Int
    discountAmount: Int
    totalAmount: Int
    couponCode: String?
    items: Json
  }
  class OrderItem <<ItemSnapshot>> {
    productId: UUID
    productName: String
    sizeId: UUID
    sizeName: String
    toppings: Json
    quantity: Int
    unitPrice: Int
    lineTotal: Int
  }
  enum OrderStatus {
    PENDING
    PAID
    PREPARING
    READY
    COMPLETED
    PAYMENT_FAILED
    CANCELLED
  }
  enum PaymentStatus {
    PENDING
    SUCCESS
    FAILED
  }
  class OrderStatusHistory {
    id: UUID
    sequence: BigInt
    fromStatus: String?
    toStatus: String
    actorId: UUID
  }
  class Payment {
    id: UUID
    idempotencyKey: UUID
    paymentMethod: String
    status: String
    amount: Int
    providerTxnRef: String?
    paymentUrl: String?
    response: Json
  }
  class Coupon <<Promotion>> {
    id: UUID
    code: String
    discountPercent: Int?
    discountAmount: Int?
    minOrderAmount: Int
    maxDiscount: Int?
    isActive: Boolean
  }
  class LoyaltyTransaction {
    id: UUID
    points: Int
    type: String
  }
}

package "Kho" {
  class Ingredient {
    id: Int
    name: String
    unit: String
    onHand: Decimal
  }
  class ProductRecipe {
    id: Int
    size: String
    quantity: Decimal
  }
  class ToppingRecipe {
    id: Int
    quantity: Decimal
  }
  class InventoryMovement {
    id: Int
    type: String
    quantity: Decimal
    reason: String
  }
}

Product "1" -- "0..*" ProductSize
Product "1" -- "0..*" ProductTopping
Topping "1" -- "0..*" ProductTopping
User "1" -- "0..*" Order
Order "1" *-- "1..*" OrderItem : snapshot
Order ..> OrderStatus : giá trị nghiệp vụ
Payment ..> PaymentStatus : giá trị nghiệp vụ
User "1" -- "0..*" OrderStatusHistory : actor
Order "1" -- "0..*" OrderStatusHistory
Order "1" -- "0..*" Payment
User "1" -- "0..*" Payment
User "1" -- "0..*" LoyaltyTransaction
Order "0..1" -- "0..*" LoyaltyTransaction
Order ..> Coupon : lưu code khi áp dụng
Product "1" -- "0..*" ProductRecipe
Topping "1" -- "0..*" ToppingRecipe
Ingredient "1" -- "0..*" ProductRecipe
Ingredient "1" -- "0..*" ToppingRecipe
Ingredient "1" -- "0..*" InventoryMovement
Order "0..1" -- "0..*" InventoryMovement

note bottom of Order
  OrderItem là snapshot trong Order.items (JSONB).
  Trạng thái được lưu dưới dạng String.
  couponCode là giá trị lưu trên đơn.
end note
note bottom of Payment
  Khóa duy nhất (userId, idempotencyKey).
  Mỗi đơn tối đa một Payment SUCCESS.
end note
@enduml
