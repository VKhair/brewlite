@startuml
title BrewLite — Trình tự checkout
skinparam shadowing false
skinparam maxMessageSize 80
autonumber

actor "Chủ đơn" as Customer
participant "Trình duyệt" as Browser
participant "Next.js UI / rewrite" as Next
participant "NestJS API" as API
database "PostgreSQL" as DB
participant "Payment Service mock" as Mock
participant "VNPay Sandbox" as Vnpay

Customer -> Browser : Xác nhận checkout
Browser -> Next : POST /api/backend/orders + Bearer
Next -> API : POST /orders
API -> API : Xác minh JWT và kiểm tra DTO
API -> DB : BEGIN; kiểm tra lựa chọn và tính giá
alt Đơn hợp lệ
  API -> DB : Ghi PENDING, snapshot, lịch sử và điểm đã dùng; COMMIT
  API --> Next : 201 Order
  Next --> Browser : 201 Order
else Dữ liệu hoặc lựa chọn không hợp lệ
  API -> DB : ROLLBACK
  API --> Next : Lỗi nghiệp vụ
  Next --> Browser : Hiện lỗi và giữ giỏ
  break Kết thúc lần checkout
    Browser --> Customer : Sửa giỏ rồi thử lại
  end
end

Browser -> Next : POST /api/backend/payments\nBearer, Idempotency-Key, orderId, paymentMethod
Next -> API : POST /payments
API -> API : Xác minh JWT, DTO và UUID v4 của key
API -> DB : BEGIN; khóa người dùng, tra key, khóa đơn nếu là lần thử mới
alt Đã có cùng key và payload
  API --> Next : Trả kết quả đã lưu
  Next --> Browser : Kết quả hoặc checkoutUrl còn hạn
else Key trùng nhưng payload khác
  API --> Next : 409 IDEMPOTENCY_CONFLICT
  Next --> Browser : Hiện lỗi
else VNPay đang PENDING với key khác
  API --> Next : 409 PAYMENT_PENDING
  Next --> Browser : Mở chi tiết đơn để tiếp tục
else Lần thử mới hợp lệ
  API -> DB : Nếu retry, kiểm tra lại lựa chọn và ghi PENDING
  API -> DB : Tính định lượng size/topping, trừ tồn có điều kiện
  break Thiếu công thức hoặc nguyên liệu
    API -> DB : ROLLBACK
    API --> Next : Lỗi thanh toán
    Next --> Browser : Báo lỗi và giữ giỏ
  end
  alt Chế độ mock
  API -> Mock : charge theo số tiền đã lưu và mockOutcome
  Mock --> API : SUCCESS hoặc FAILED
  alt Thành công
    API -> DB : Ghi Payment SUCCESS, tiêu hao, PAID và điểm; COMMIT
  else Thất bại
    API -> DB : Ghi Payment FAILED, tiêu hao và hoàn theo paymentId; ghi PAYMENT_FAILED; COMMIT
  end
  API --> Next : Kết quả và cartAction
  Next --> Browser : Kết quả
else VNPay
  API -> DB : Ghi Payment PENDING, mã thử và tiêu hao theo paymentId; COMMIT
  API --> Next : checkoutUrl có chữ ký, hạn 15 phút
  Next --> Browser : checkoutUrl
  Browser -> Vnpay : Mở cổng Sandbox
  par Return qua trình duyệt
    Vnpay --> Browser : Chuyển đến Return URL
    Browser -> API : GET /payments/vnpay/return
    API -> DB : Tra lần thử và đối chiếu số tiền
    API --> Browser : 302, trang kết quả hoặc danh sách đơn
  else IPN trực tiếp
    Vnpay -> API : GET /payments/vnpay/ipn
    API -> API : Xác minh chữ ký và mã terminal
    API -> DB : BEGIN; khóa người dùng và đơn, đối chiếu tham chiếu và số tiền
    alt IPN xác nhận thành công
      API -> DB : Ghi SUCCESS, PAID và cộng điểm; COMMIT
    else IPN xác nhận thất bại
      API -> DB : Ghi FAILED, PAYMENT_FAILED và hoàn tồn theo paymentId; COMMIT
    else IPN thành công sau hủy
      API -> DB : Đánh dấu cần đối soát hoàn tiền
    else IPN không hợp lệ hoặc đã xác nhận
      API -> API : Trả mã phù hợp và giữ dữ liệu
    end
    API --> Vnpay : HTTP 200 với RspCode và Message
  end
  end
end

opt Trang kết quả được mở
  Browser -> Next : GET /api/backend/orders/:id + Bearer
  Next -> API : GET /orders/:id
  API -> DB : Đọc đơn theo UUID và chủ sở hữu
  API --> Next : Trạng thái, snapshot và lịch sử
  Next --> Browser : Chi tiết đơn
  note over Browser
    Khi PENDING, hỏi lại khoảng 2 giây một lần
    trong tối đa 30 giây. Xóa giỏ còn gắn với đơn đã trả tiền.
  end note
end
opt Chủ đơn yêu cầu hủy đơn PENDING
  Browser -> Next : PATCH /api/backend/orders/:id/cancel + Bearer
  Next -> API : PATCH /orders/:id/cancel
  API -> DB : BEGIN; khóa người dùng và đơn
  alt VNPay đang PENDING và còn hạn
    API --> Next : 409 PAYMENT_PENDING
  else Hủy hợp lệ
    API -> DB : Nếu VNPay quá hạn, ghi FAILED và hoàn tồn theo paymentId
    API -> DB : Hoàn điểm, ghi CANCELLED và lịch sử; COMMIT
    API --> Next : 200 CANCELLED
  end
  Next --> Browser : Kết quả hủy
end
@enduml
