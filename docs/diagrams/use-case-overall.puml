@startuml
title BrewLite — Use case tổng quan
left to right direction
!pragma layout smetana
skinparam shadowing false

actor "Khách truy cập" as Visitor
actor "Người dùng có tài khoản" as User
actor "Nhân viên (STAFF)" as Staff
actor "Quản trị viên (ADMIN)" as Admin
actor "VNPay Sandbox" as Gateway
actor "Vận hành" as Operator

User --|> Visitor
Staff --|> User
Admin --|> Staff

rectangle "Web khách hàng" {
  usecase "Xem, tìm và lọc thực đơn" as Menu
  usecase "Chọn món, size và topping" as Product
  usecase "Quản lý giỏ cục bộ" as Cart
  usecase "Đăng ký hoặc đăng nhập" as Auth
  usecase "Đặt và thanh toán đơn" as Checkout
  usecase "Xem kết quả, lịch sử\nvà chi tiết đơn của mình" as Track
  usecase "Thử lại hoặc hủy đơn đủ điều kiện" as Manage
}

rectangle "API và tích hợp" {
  usecase "Cập nhật trạng thái pha chế" as Progress
  usecase "Quản lý nguyên liệu,\nbiến động và công thức" as Stock
  usecase "Tra coupon và dùng coupon hoặc điểm khi tạo đơn" as Discount
  usecase "Chốt giao dịch qua IPN" as Settle
  usecase "Kiểm tra API và DB" as Health
}

Visitor --> Menu
Visitor --> Product
Visitor --> Cart
Visitor --> Auth
User --> Checkout
User --> Track
User --> Manage
User --> Discount
Staff --> Progress
Admin --> Stock
Gateway --> Settle
Operator --> Health
note right of Discount
  UI checkout hiện chỉ gửi các dòng hàng.
  Coupon và điểm có hợp đồng API.
end note
@enduml
