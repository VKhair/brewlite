{
  "name": "brewlite",
  "version": "1.0.0",
  "private": true,
  "description": "Ứng dụng đặt đồ uống mobile-first/PWA. Stack: Next.js, NestJS, PostgreSQL, Docker.",
  "homepage": "https://github.com/VKhair/brewlite#readme",
  "bugs": {
    "url": "https://github.com/VKhair/brewlite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VKhair/brewlite.git"
  },
  "license": "ISC",
  "author": "BrewLite Team",
  "workspaces": [
    "apps/*"
  ],
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "db:setup": "npm run db:setup --workspace=api",
    "db:seed": "npm run db:seed --workspace=api",
    "user:staff": "npm run user:staff --workspace=api --",
    "lint": "npm run lint --workspaces --if-present",
    "lint:api": "npm run lint --workspace=api",
    "lint:web": "npm run lint --workspace=web",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace=api",
    "test:web": "npm run test --workspace=web",
    "test:integration": "npm run test:integration --workspace=api --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "clean": "node -e \"const fs = require('fs'); ['dist', '.next', 'apps/api/dist', 'apps/web/.next'].forEach(p => fs.rmSync(p, { recursive: true, force: true }));\""
  },
  "engines": {
    "node": ">=20.12.0",
    "npm": ">=10.0.0"
  }
}
